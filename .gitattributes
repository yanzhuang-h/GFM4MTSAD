* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.json text eol=lf

*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pt binary
*.pth binary
*.ckpt binary

# Registered source configs are hash-locked byte copies, including line endings.
configs/registered/*.yaml -text

# Keep upstream permission notices byte-identical, including Markdown spacing.
licenses/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
LICENSE text eol=lf
licenses/NOTICE text eol=lf
